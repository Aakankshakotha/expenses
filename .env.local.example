# ── Google OAuth ──────────────────────────────────────────────────────────────

# In Google Cloud Console → APIs & Services → Credentials → your OAuth 2.0 Client ID
# (Web application), add EVERY origin you use locally to "Authorized JavaScript origins":
#   http://localhost:3000
#   http://localhost:52155
# (52155 is used when you run `npm run dev:groww` for Groww MCP — same app, different port.)

# Client ID from Google Cloud Console (safe to expose — it's a public identifier)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Client Secret from Google Cloud Console (SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_)
# Required for the secure authorization code exchange in /api/auth/signin
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Groww MCP OAuth ───────────────────────────────────────────────────────────
# Groww only allowlists fixed redirect URIs (e.g. http://localhost:52155/oauth/callback).
# Run: npm run dev:groww   then open http://localhost:52155 for Groww connect.
# Optional override if Groww whitelists your URL:
# GROWW_OAUTH_CALLBACK_URL=https://your-domain/oauth/callback
